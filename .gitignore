# ---- Rust: the MLX tool-call guard ------------------------------------------
qwen-clef-repe-guard/target/
qwen-clef-repe-guard/**/*.rs.bk

# ---- RepE guard: derived vectors, archives, second build tree ---------------
artifacts/
# Re-include the guard's artifact directory so the calibrated vectors inside
# it can be versioned (the blanket `artifacts/` rule above would otherwise
# stop git from descending into it).
!qwen-clef-repe-guard/artifacts/
qwen-clef-repe-guard/artifacts/*
qwen-clef-repe-guard.zip
repe-mods/target/

# The CALIBRATED vectors are not derived from the source tree: they are the
# measured operating point, they cost minutes of calibration against a
# specific checkpoint snapshot, and they are what the running guard loads.
# Version them, so a fresh clone reproduces the SAME behaviour instead of a
# re-derived one.
!qwen-clef-repe-guard/artifacts/*.safetensors
!qwen-clef-repe-guard/artifacts/*.jsonl
!qwen-clef-repe-guard/artifacts/*.log
# ...but not the multi-megabyte scratch the parity dumps leave behind.
qwen-clef-repe-guard/artifacts/gdn_probe/
qwen-clef-repe-guard/artifacts/whiten/

# ---- site QA scratch (regenerated by playwright passes) ---------------------
clef-site/shots/
.playwright-cli/
.DS_Store

# ===========================================================================
#  CLEF guard — production reverse proxy.
#
#  This file is the PUBLIC face of the MLX tool-call guard.  It does three
#  jobs and nothing else:
#
#    1. Terminates TLS with an automatically renewed ACME certificate.
#    2. Serves the static demo site (clef-site/) from the SAME ORIGIN as the
#       API, so the browser never makes a cross-origin request and the
#       guard never has to relax CORS.
#    3. Rate limits by client IP, and forwards /api/*, /v1/* and /health to
#       the local guard process.
#
#  Everything that differs per machine lives in the ENVIRONMENT, not in this
#  file.  The service loads /opt/zcode/caddy/caddy.env (KEY=VALUE) before it
#  reads this file, so one Caddyfile works on every box:
#
#    CLEF_DOMAIN   public hostname, e.g. clef.example.com   (required)
#    GUARD_PORT    local port the guard listens on   (default 8090)
#    SITE_ROOT     directory holding the static site (default /opt/zcode/site)
#    ACME_EMAIL    contact address for the ACME account        (required)
#    RL_*          the edge rate limits (see the header below)
#
#  There is deliberately NO token in this file.  The guard's bearer token
#  is the operator's credential — direct clients on the box send it
#  themselves — and the public path uses a device-bound session cookie
#  instead.  Injecting the operator token here would make the guard unable
#  to tell a visitor from the operator, and the session gate would be
#  decorative.  See the handle block below.
#
#  VALIDATE BEFORE YOU RELOAD.  A bad Caddyfile must never reach the
#  running server:
#
#    caddy validate --config /opt/zcode/caddy/Caddyfile \
#                       --envfile /opt/zcode/caddy/caddy.env
#
#  ---------------------------------------------------------------------------
#  RATE LIMITING BELONGS HERE, AT THE EDGE, KEYED BY CLIENT IP.
#
#  Two reasons:
#
#    * It sheds load before it costs anything.  The expensive part of this
#      system is the model forward pass behind /v1/*.  A limit inside the
#      guard is applied AFTER the request was accepted and routed.
#    * It is keyed on the address this proxy saw on the socket.  The guard's
#      own limiter has to trust X-Forwarded-For because it sits behind a
#      proxy; this one trusts no header at all, so there is nothing to
#      forge.  (Measured: a client that sends its own X-Forwarded-For has it
#      REPLACED with the address Caddy saw — see the note on the
#      X-Real-IP header below.)
#
#  The zone below uses the `rate_limit` directive, which is NOT part of the
#  standard Caddy build.  It comes from the community module
#  github.com/mholt/caddy-ratelimit and has to be compiled in:
#
#    xcaddy build --with github.com/mholt/caddy-ratelimit \
#                 --output /opt/zcode/bin/caddy
#
#  A Caddyfile that contains `rate_limit` on a binary WITHOUT the module is
#  a parse error — Caddy refuses to load it rather than quietly serving an
#  unprotected site.  So if this config refuses to load with
#  "unrecognized directive: rate_limit", the fix is the BINARY, not this
#  file.  scripts/bootstrap_cloud_metal.sh builds that binary for you.
#
#  The limits are in the ENVIRONMENT, like everything else that differs per
#  machine, so an operator can tune them without touching this file:
#
#    RL_TOOL_CALL_EVENTS   /v1/* per IP per window   (default 10)
#    RL_TOOL_CALL_WINDOW   /v1/* window              (default 1m)
#    RL_API_EVENTS         /api/* per IP per window  (default 60)
#    RL_API_WINDOW         /api/* window             (default 1m)
#  ---------------------------------------------------------------------------
#
#  The variables marked "required" above have NO default on purpose.  An
#  unset CLEF_DOMAIN or ACME_EMAIL has to fail loudly at parse time rather
#  than quietly serve the wrong thing.
# ===========================================================================
{
	# Contact address for the ACME account.  Caddy uses it for expiry
	# warnings; it never appears in a certificate.
	email {$ACME_EMAIL}

	# Keep the certificates and the ACME account in a predictable place
	# instead of the root user's home directory, so a backup or a rebuild
	# knows where to look.
	storage file_system {$CADDY_STORAGE:/var/lib/caddy}
}

# The site address.  Caddy binds :443 and :80 and redirects plain HTTP to
# HTTPS on its own.  The certificate is obtained and renewed by ACME
# (HTTP-01 / TLS-ALPN-01) — there is no certificate file to manage here.
{$CLEF_DOMAIN} {
	# The static site.  `clef-site/` from the repository is copied here at
	# install time: index.html, js/, styles.css, data/ and vendor/ are all
	# served from the same origin as the API below.
	root * {$SITE_ROOT:/opt/zcode/site}

	# Compression for the static assets and the JSON API.  zstd first,
	# gzip for the clients that do not speak zstd.
	encode zstd gzip

	# The API accepts small JSON tool-call probes — it is not an upload
	# endpoint.  Anything bigger is refused with 413 before a handler runs.
	# (request_body needs Caddy v2.10 or newer; the build this file needs
	# is far newer than that.)
	request_body {
		max_size 1MB
	}

	# Security headers.  `-Server` removes the Caddy signature; the rest
	# are the ordinary browser hardening headers.  The CSP is tight on
	# purpose: the site loads only its own scripts, the Google Fonts
	# stylesheet and the fonts it serves, and talks to nothing but its own
	# origin.  If you host the site somewhere else, widen it here.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# Access log, so an operator can see who called what and how the rate
	# limiter is doing.  Delete this block if you ship the access log
	# somewhere else.
	log {
		output file {$CADDY_ACCESS_LOG:/var/log/zcode/caddy-access.log} {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	# Everything the browser asks the GUARD for:
	#   /api/info          the model's facts
	#   /api/events        the live telemetry stream (SSE)
	#   /v1/guard/tool-call the tool-call probe
	#   /health            the liveness probe
	#
	# Everything here is expensive enough to need an edge rate limit keyed
	# by client IP.  See the header of this file and deploy/README.md —
	# "Rate limiting belongs at THIS layer, keyed by IP".  The zones live
	# INSIDE the handle block below, so they apply to the guarded routes
	# and to nothing else: the static site is served outside it.
	@guard path /api/* /v1/* /health

	handle @guard {
		# The edge rate limit, keyed by the address Caddy saw on the
		# socket.  {remote_host} is that address — it is not a header, so
		# a client cannot choose its own bucket by sending one.
		#
		# Two zones because the two halves cost very different amounts:
		# /v1/* runs the model, /api/* is JSON and an event stream.  The
		# static site and /health are in NEITHER zone, so a visitor
		# loading the page is never throttled and the liveness probe is
		# never throttled.
		#
		# ipv6_prefix 64 puts every address in an IPv6 /64 into ONE
		# bucket, because a /64 is what an ISP hands to a household and
		# cycling addresses inside it is free.  There is deliberately NO
		# ipv4_prefix: masking IPv4 to a /24 would put an entire
		# university or office NAT into one bucket and throttle every
		# student behind it.
		rate_limit {
			zone tool_call {
				match {
					path /v1/*
				}
				key {remote_host}
				window {$RL_TOOL_CALL_WINDOW:1m}
				events {$RL_TOOL_CALL_EVENTS:10}
				ipv6_prefix 64
			}
			zone api {
				match {
					path /api/*
				}
				key {remote_host}
				window {$RL_API_WINDOW:1m}
				events {$RL_API_EVENTS:60}
				ipv6_prefix 64
			}
		}

		reverse_proxy 127.0.0.1:{$GUARD_PORT:8090} {
			# NO Authorization header is injected here, and that is deliberate.
			#
			# The guard accepts two credentials: the operator's bearer token,
			# and a device-bound session cookie that a visitor gets from
			# POST /api/session.  If this proxy injected the operator token
			# on every request, the guard could not tell a visitor from the
			# operator, and the session gate would be decorative.
			#
			# So the operator's token stays on the box — direct clients send
			# it themselves — and the public path carries a session.
			#
			# The proxy passes cookies through untouched, which is what makes
			# the session work: the browser sends zcode_sid and zcode_dev,
			# and the guard checks that the pair belongs together.
			#
			# Cookies also have to survive the redirect from http to https,
			# so do not strip them.

			# X-Forwarded-For is NOT set here on purpose.  Caddy already
			# replaces it with the address it saw on the socket, so a
			# client that sends its own X-Forwarded-For gets it discarded
			# rather than appended — which is exactly what the guard's
			# right-most-XFF rule depends on.  Setting it here as well
			# would be a second copy of the same value and Caddy warns
			# about it.
			#
			# X-Real-IP is NOT a Caddy default, so this one earns its
			# place: the guard reads it to key its own backstop limiter,
			# and --trust-proxy makes it believe it.
			header_up X-Real-IP {remote_host}

			# Stream the response through, unbuffered, so the SSE endpoint
			# (/api/events) arrives event by event instead of in one lump
			# at the end.
			flush_interval -1
		}
	}

	# Everything else is the static site.
	handle {
		file_server
	}
}
